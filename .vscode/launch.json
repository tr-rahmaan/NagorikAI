{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "▶️ Run CivicSphere AI (Streamlit)",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/app.py",
                "--server.port=8501"
            ],
            "python": "/Library/Frameworks/Python.framework/Versions/3.14/bin/python3",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "STREAMLIT_CONFIG_DIR": "${workspaceFolder}/.streamlit"
            }
        }
    ]
}
